
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Freelancer Profile - GigHives</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="profile-page">

    <main class="profile-container">

        <div class="profile-card">

            <h1>My Freelancer Profile</h1>
            <p class="profile-description">
                Create your profile so clients can discover your skills.
            </p>
            <% if (success) { %>
    <div class="success-message">
        Your freelancer profile has been saved successfully!
    </div>
<% } %>

            <form action="/student/profile" method="POST">

                <div class="form-group">
                    <label>About Me</label>
                    <textarea
                        name="bio"
                        placeholder="Introduce yourself..."
                        required
                    ><%= profile ? profile.bio : "" %></textarea>
                </div>

                <div class="form-group">
                    <label>My Skills</label>
                    <input
                        type="text"
                        name="skills"
                        placeholder="HTML, CSS, JavaScript..."
                        value="<%= profile ? profile.skills : "" %>"
                        required
                    >
                </div>

                <div class="form-group">
                    <label>Experience</label>
                    <select name="experience" required>
                        <option value="">Select experience</option>
                        <option value="Beginner" <%= profile && profile.experience === "Beginner" ? "selected" : "" %>>Beginner</option>
                        <option value="Intermediate" <%= profile && profile.experience === "Intermediate" ? "selected" : "" %>>Intermediate</option>
                        <option value="Experienced" <%= profile && profile.experience === "Experienced" ? "selected" : "" %>>Experienced</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Portfolio URL <span>(Optional)</span></label>
                    <input
                        type="url"
                        name="portfolio_url"
                        placeholder="https://example.com"
                        value="<%= profile ? profile.portfolio_url : "" %>"
                    >
                </div>

                <button type="submit" class="save-profile-btn">
                    Save Profile
                </button>

            </form>

            <a href="/student/dashboard" class="back-link">
                ← Back to Dashboard
            </a>

        </div>

    </main>

</body>
</html>
