
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hire Freelancer - GigHives</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="hire-page hire-request-page"></body>

    <main class="hire-container">

        <!-- Hiring form card -->
        <div class="hire-form-card">

            <h1>Hire a Freelancer</h1>

            <p class="hire-description">
                You are sending a hiring request to:
            </p>

            <h2><%= student.full_name %></h2>

            <form action="/hire/request/<%= student.id %>"
                  method="POST">

                <div class="form-group">
                    <label for="project_title">
                        Project Title
                    </label>

                    <input
                        type="text"
                        id="project_title"
                        name="project_title"
                        placeholder="Example: Website Development"
                        maxlength="150"
                        required>
                </div>

                <div class="form-group">
                    <label for="description">
                        Project Description
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        rows="6"
                        placeholder="Explain the work you want the student to complete..."
                        required></textarea>
                </div>

                <div class="form-group">
                    <label for="budget">
                        Your Budget (Nu.)
                    </label>

                    <input
                        type="number"
                        id="budget"
                        name="budget"
                        min="0.01"
                        step="0.01"
                        placeholder="Example: 5000"
                        required>
                </div>

                <div class="form-group">
                    <label for="deadline">
                        Project Deadline
                    </label>

                    <input
                        type="date"
                        id="deadline"
                        name="deadline">
                </div>

                <button type="submit" class="save-profile-btn">
                    Send Hiring Request
                </button>

            </form>

            <a href="/hire" class="hire-back-link">
                Cancel and Go Back
            </a>

        </div>
        <!-- End hiring form card -->

    </main>

</body>
</html>
