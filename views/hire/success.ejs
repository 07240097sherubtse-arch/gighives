
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request Sent - GigHives</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="hire-request-page">

    <main class="hire-container">

        <div class="hire-form-card hire-success-card">

            <div class="success-icon">✓</div>

            <h1>Hiring Request Sent!</h1>

            <p class="hire-description">
                Your hiring request has been successfully sent to
                <strong><%= studentName %></strong>.
            </p>

            <p class="success-details">
                The student can now review your project details
                and respond to your request.
            </p>

            <a href="/hire" class="success-primary-btn">
                Browse More Freelancers
            </a>

            <a href="/" class="success-secondary-btn">
                Back to Home
            </a>

        </div>

    </main>

</body>
</html>
