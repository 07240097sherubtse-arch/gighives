
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GigHives - Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- Navigation Bar -->
    <nav class="navbar">
        <h2 class="logo">GigHives</h2>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/jobs">Find Jobs</a>
            <a href="/hire">Hire Skills</a>
            <a href="/jobs/post">Post a Job</a>
        </div>

        <div class="nav-buttons">

            <% if (user) { %>

                <span class="welcome-user">
                    Welcome, <%= user.name %>
                </span>
                <a href="/notifications" class="notification-link">
    <span class="notification-icon">🔔</span>

    <% if (unreadNotificationCount > 0) { %>
        <span class="notification-badge">
            <%= unreadNotificationCount %>
        </span>
    <% } %>
</a>

                <% if (user.role === "student") { %>
                    <a href="/student/dashboard" class="login-btn">
                        Student Dashboard
                    </a>

                <% } else if (user.role === "client") { %>
    <a href="/client/dashboard" class="login-btn">
        Client Dashboard
    </a>

<% } else if (user.role === "admin") { %>
    <a href="/admin/dashboard" class="login-btn">
        Admin Dashboard
    </a>
<% } %>

                <form action="/logout" method="POST">
                    <button type="submit" class="login-btn">Logout</button>
                </form>

            <% } else { %>

                <a href="/login" class="login-btn">Login</a>
                <a href="/register" class="signup-btn">Sign Up</a>

            <% } %>

        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">

        <div class="hero-content">

            <h1>
                Your Skills.
                <span>Your Opportunities.</span>
                Your Future.
            </h1>

            <p>
                GigHives connects talented students with people
                who need their skills. Find opportunities, work
                on real projects, and earn through your talent.
            </p>

            <div class="hero-buttons">
                <a href="/register" class="primary-btn">
                    Find Work
                </a>

                <a href="/jobs/post" class="secondary-btn">
                    Hire Talent
                </a>
            </div>

        </div>

    </section>

    <!-- How It Works Section -->
    <section class="how-it-works">

        <div class="section-heading">
            <h2>How GigHives Works</h2>
            <p>Getting started is simple. Follow three easy steps.</p>
        </div>

        <div class="steps">

            <div class="step-card">
                <h3>01</h3>
                <h4>Create an Account</h4>
                <p>Join GigHives as a student or a client.</p>
            </div>

            <div class="step-card">
                <h3>02</h3>
                <h4>Find or Post a Gig</h4>
                <p>Discover opportunities or find talented students.</p>
            </div>

            <div class="step-card">
                <h3>03</h3>
                <h4>Work and Get Paid</h4>
                <p>Complete projects, build experience and earn money.</p>
            </div>

        </div>

    </section>

    <!-- Featured Jobs Section -->
    <section class="featured-jobs">

        <div class="section-heading">
            <h2>Featured Opportunities</h2>
            <p>Explore opportunities and put your skills to work.</p>
        </div>

        <div class="job-container">

            <div class="job-card">
                <span class="job-category">Design</span>
                <h3>Logo Designer</h3>
                <p>Create a professional logo for a small business.</p>
                <h4>Budget: Nu. 1,500</h4>
                <a href="/jobs" class="job-btn">View Details</a>
            </div>

            <div class="job-card">
                <span class="job-category">Development</span>
                <h3>Website Developer</h3>
                <p>Build a simple website for a local business.</p>
                <h4>Budget: Nu. 5,000</h4>
                <a href="/jobs" class="job-btn">View Details</a>
            </div>

            <div class="job-card">
                <span class="job-category">Writing</span>
                <h3>Content Writer</h3>
                <p>Write engaging content for social media.</p>
                <h4>Budget: Nu. 1,000</h4>
                <a href="/jobs" class="job-btn">View Details</a>
            </div>

        </div>

    </section>

    <!-- Why Choose GigHives Section -->
    <section class="why-gighives">

        <div class="section-heading">
            <h2>Why Choose GigHives?</h2>
            <p>A platform built to connect skills with opportunities.</p>
        </div>

        <div class="benefits">

            <div class="benefit-card">
                <h3>For Students</h3>
                <p>
                    Find freelance opportunities, gain practical
                    experience and earn while studying.
                </p>
            </div>

            <div class="benefit-card">
                <h3>For Clients</h3>
                <p>
                    Find talented students who can help you
                    complete projects and tasks.
                </p>
            </div>

            <div class="benefit-card">
                <h3>Simple and Accessible</h3>
                <p>
                    Discover opportunities and connect with
                    people through one convenient platform.
                </p>
            </div>

        </div>

    </section>

    <!-- Footer -->
    <footer class="footer">

        <div class="footer-container">

            <div class="footer-about">
                <h2>GigHives</h2>
                <p>
                    Connecting student talent with real-world
                    opportunities.
                </p>
            </div>

            <div class="footer-links">
                <h3>Account</h3>

                <% if (user) { %>

                    <span>Welcome, <%= user.name %></span>

                    <% if (user.role === "student") { %>
                        <a href="/student/dashboard">Student Dashboard</a>

                    <% } else if (user.role === "client") { %>
    <a href="/client/dashboard">Client Dashboard</a>
    <a href="/client/dashboard">Applications Received</a>

<% } else if (user.role === "admin") { %>
    <a href="/admin/dashboard">Admin Dashboard</a>
<% } %>

                    <form action="/logout" method="POST">
                        <button type="submit">Logout</button>
                    </form>

                <% } else { %>

                    <a href="/login">Login</a>
                    <a href="/register">Sign Up</a>

                <% } %>

            </div>

        </div>

        <div class="footer-bottom">
            <p>&copy; 2026 GigHives. All rights reserved.</p>
        </div>

    </footer>

</body>
</html>
